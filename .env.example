# Higgsfield API – för videogenerering på hemsidan
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=https://api.higgsfield.ai/v1

# Mottagare för offertförfrågningar (intern inkorg)
QUOTE_RECIPIENT_EMAIL=hej@optimeraenergi.se

# Resend (SMTP/transactional). När detta är satt skickas:
#   1. Internt mail till julian@proffskontakt.se + tilldelad säljare
#   2. Bekräftelsemail till kunden
RESEND_API_KEY=

# KT Central (ProffsKontakt CRM) – webhook som tar emot leads
KT_CENTRAL_WEBHOOK_URL=
KT_CENTRAL_WEBHOOK_TOKEN=

# Site URL
NEXT_PUBLIC_SITE_URL=https://optimeraenergi.se

# Admin-sektionen (/admin) – delat lösenord för internt team
ADMIN_PASSWORD=

# Idé-hörnan: skicka varje ny idé till en webhook (Slack, Notion, KT Central…)
IDEAS_WEBHOOK_URL=
IDEAS_WEBHOOK_TOKEN=

# Cookiebot – Domain Group ID (CBID) från manage.cookiebot.com.
# När den är satt laddas Cookiebot-bannern (auto-blocking) + cookie-
# deklarationen på /cookies. Lämnas tom → ingen banner laddas.
NEXT_PUBLIC_COOKIEBOT_CBID=
