# Higgsfield API – för videogenerering på hemsidan
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=https://api.higgsfield.ai/v1

# Mottagare för offertförfrågningar (intern inkorg)
QUOTE_RECIPIENT_EMAIL=hej@optimeraenergi.se

# Resend (SMTP/transactional). När detta är satt skickas:
#   1. Internt mail till julian@proffskontakt.se + tilldelad säljare
#   2. Bekräftelsemail till kunden
RESEND_API_KEY=

# KT Central / Sentinel HQ (CRM) – webhook som tar emot leads
KT_CENTRAL_WEBHOOK_URL=
KT_CENTRAL_WEBHOOK_TOKEN=
# Delad HMAC-hemlighet: webbplatsen signerar utgående leads (X-OE-Signature),
# CRM:et verifierar. Generera 32+ slumpbytes. Lämna tom -> ingen signering.
KT_CENTRAL_WEBHOOK_SECRET=

# Closed-loop relä (/api/conversions): CRM skickar köp/kvalificering hit,
# webbplatsen vidarebefordrar till GA4 server-side.
#   CONVERSION_RELAY_SECRET – delad HMAC-hemlighet website <-> CRM (server-only)
#   GA4_MP_API_SECRET       – GA4 Measurement Protocol-secret (server-only!)
#   GA4_MEASUREMENT_ID      – GA4 mät-id (default G-5DY857B8TL)
CONVERSION_RELAY_SECRET=
GA4_MP_API_SECRET=
GA4_MEASUREMENT_ID=G-5DY857B8TL

# Vercel Blob – lagring för admin-uppladdade bilder (/admin/media).
# Skapas automatiskt när du lägger till en Blob-store i Vercel
# (Storage → Create → Blob). Behöver inte sättas manuellt lokalt.
BLOB_READ_WRITE_TOKEN=

# Site URL
NEXT_PUBLIC_SITE_URL=https://optimeraenergi.se

# Admin-sektionen (/admin) – delat lösenord för internt team
ADMIN_PASSWORD=

# Idé-hörnan: skicka varje ny idé till en webhook (Slack, Notion, KT Central…)
IDEAS_WEBHOOK_URL=
IDEAS_WEBHOOK_TOKEN=

# Cookiebot – Domain Group ID (CBID) från manage.cookiebot.com.
# När den är satt laddas Cookiebot-bannern (auto-blocking) + cookie-
# deklarationen på /cookies. Lämnas tom → ingen banner laddas.
NEXT_PUBLIC_COOKIEBOT_CBID=

# Sökmotor-verifiering. Hämta koden från:
#   Google Search Console: search.google.com/search-console
#   Bing Webmaster Tools:  bing.com/webmasters
# Klistra in HTML-tag-värdet (utan "content=" och citattecken).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
